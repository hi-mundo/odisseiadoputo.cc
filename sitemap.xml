---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">

  <!-- Homepage -->
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="pt-BR" href="{{ site.url }}{{ site.baseurl }}/"/>
    <xhtml:link rel="alternate" hreflang="en"    href="{{ site.url }}{{ site.baseurl }}/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ site.baseurl }}/"/>
  </url>

  {%- comment -%} Posts {%- endcomment -%}
  {% for post in site.posts %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
    <xhtml:link rel="alternate" hreflang="pt-BR" href="{{ site.url }}{{ post.url }}"/>
    {% if post.en_content %}<xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}{{ post.url }}"/>{% endif %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ post.url }}"/>
  </url>
  {% endfor %}

  {%- comment -%} Static pages (about, apoie, etc.) — exclui arquivos especiais {%- endcomment -%}
  {% for page in site.pages %}
    {% if page.sitemap != false
       and page.url != '/'
       and page.url != '/index.html'
       and page.url != '/404.html'
       and page.url != '/sitemap.xml'
       and page.url != '/robots.txt'
       and page.url != '/feed.xml'
       and page.title %}
  <url>
    <loc>{{ site.url }}{{ page.url | replace: 'index.html', '' }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
    {% endif %}
  {% endfor %}

</urlset>
