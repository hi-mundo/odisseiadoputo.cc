source 'https://rubygems.org'

# Ruby ≥ 3.4: várias libs saíram das default gems; declarar aqui evita LoadError no bundle exec (ex.: Cloudflare Pages).
gem "base64", "~> 0.2"
gem "bigdecimal", ">= 3.1"

# ffi 1.15.x tem gem pré-compilada para macOS e funciona com Ruby 2.6
gem "ffi", "~> 1.15.0"

gem "jekyll", "~> 3.9"

group :jekyll_plugins do
  gem "jekyll-paginate"
  gem "jekyll-feed"
  gem "jekyll-watch"
  gem "jekyll-sitemap"
end

gem "kramdown"
gem "kramdown-parser-gfm"
