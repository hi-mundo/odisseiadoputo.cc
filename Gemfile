source 'https://rubygems.org'

# Ruby ≥ 3.4: base64 saiu das default gems; safe_yaml/Jekyll precisam no bundle (ex.: Cloudflare Pages).
gem "base64", "~> 0.2"

# ffi 1.15.x tem gem pré-compilada para macOS e funciona com Ruby 2.6
gem "ffi", "~> 1.15.0"

gem "jekyll", "~> 3.9"

group :jekyll_plugins do
  gem "jekyll-paginate"
  gem "jekyll-feed"
  gem "jekyll-watch"
end

gem "kramdown"
gem "kramdown-parser-gfm"
